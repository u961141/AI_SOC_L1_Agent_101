# ===================================================================
# Enterprise FortiGate Firewall MCP Integration (.env.example)
# ===================================================================

# 1. FortiGate Firewall Configuration
FORTIGATE_IP=your_fortigate_ip_here
FORTIGATE_API_TOKEN=your_fortigate_api_token_here
FORTIGATE_VDOM=root
FORTIGATE_VERIFY_SSL=false
FORTIGATE_BLOCK_GROUP=Blocked_Bad_IPs

# 2. AbuseIPDB Threat Intelligence API Integration
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
ABUSE_SCORE_THRESHOLD=50

# 3. Local GPU LLM Configuration
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_BASE_URL=http://localhost:11434

# 4. LangSmith Observability & Telemetry Cloud (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=MCP102-FortiGate
